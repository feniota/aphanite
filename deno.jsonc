{
  "$schema": "https://github.com/denoland/deno/raw/refs/heads/main/cli/schemas/config-file.v1.json",
  "lint": {
    "exclude": ["scripts/"],
    "rules": {
      "exclude": ["no-window"]
    }
  },
  "imports": {
    "@/": "./web/src/",
    "@feniota/tiny-skin-viewer": "jsr:@feniota/tiny-skin-viewer@0.2.4"
  },
  "nodeModulesDir": "auto",
  "jsrDepsInNodeModules": true,
  "exclude": [
    "target/", // This might include some JavaScript files generated by rustdoc
    "web/dist"
  ],
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"]
  },
  "minimumDependencyAge": {
    "age": 1440,
    "exclude": ["jsr:@feniota/tiny-skin-viewer", "npm:@jsr/feniota__tiny-skin-viewer"]
  }
}
