{
  "name": "aphanite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "deno run -P ./scripts/dev.ts",
    "build": "deno run -P ./scripts/build.ts",
    "check": "svelte-check --tsconfig ./web/tsconfig.app.json --compiler-warnings 'a11y-*:ignore' && tsc -p ./web/tsconfig.node.json",
    "long-cn": "deno run --allow-read=web/src --allow-write=web/src scripts/reformat-long-cn.ts && deno task check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.2",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-svelte": "^0.5.5",
    "qrcode": "^1.5.4",
    "regexparam": "^3.0.0",
    "svelte-spa-router": "^5.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.27.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.5",
    "lorem-ipsum": "^3.0.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
